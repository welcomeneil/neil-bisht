# Spotify "now playing" feed — see setup steps below.
# Copy this file to .env.local and fill in the values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# /admin snapshot uploader. Commits the photo + content/snapshots.json to the repo,
# which triggers a Vercel deploy.
#
# GITHUB_TOKEN: fine-grained PAT, this repo only, "Contents: Read and write".
#   https://github.com/settings/personal-access-tokens/new
# ADMIN_PASSWORD: anything long. Guards POST /api/snapshots.
GITHUB_TOKEN=
GITHUB_REPO=welcomeneil/neil-bisht
GITHUB_BRANCH=main
ADMIN_PASSWORD=
